{
  "name": "sakura-mcp-server",
  "version": "0.1.0",
  "description": "Secure MCP gateway for Sakura EcoSystem, Life Dashboard, Home Assistant and DSH.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "keywords": ["mcp", "model-context-protocol", "home-assistant", "authentik", "sakura"],
  "author": "Guyao146",
  "license": "LGPL-2.1-only",
  "engines": { "node": ">=22" },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "hono": "^4.11.4",
    "jose": "^6.2.10",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pino": "^7.0.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
