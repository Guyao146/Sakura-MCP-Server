# Public URL of this server. It must be HTTPS in production.
PUBLIC_BASE_URL=https://mcp.example.com
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Comma-separated credentials in id:secret:scope scope form. Generate secrets with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Example scopes: life:read,home:read,todo:read,todo:write,dsh:summary,dsh:followup,home:control
MCP_API_KEYS=local-agent:replace-with-a-32-byte-random-secret:life:read|home:read|todo:read|todo:write|dsh:summary

# Optional Authentik JWT validation. When all values are present, a Bearer JWT issued
# for AUTHENTIK_AUDIENCE is accepted in addition to MCP_API_KEYS.
AUTHENTIK_ISSUER=https://login.example.com/application/o/sakura-mcp/
AUTHENTIK_AUDIENCE=https://mcp.example.com
AUTHENTIK_JWKS_URI=https://login.example.com/application/o/sakura-mcp/jwks/
# Optional mapping when Authentik does not put scopes in the standard scope claim.
AUTHENTIK_SCOPE_CLAIM=scope

# Optional Home Assistant adapter. A dedicated, least-privilege HA token is required.
HOME_ASSISTANT_URL=https://home.example.com
HOME_ASSISTANT_TOKEN=replace-with-dedicated-mcp-token
# Comma-separated whitelist. Empty means all device-control tools are disabled.
HOME_ASSISTANT_CONTROLLABLE_ENTITIES=light.living_room,switch.coffee_machine
HOME_ASSISTANT_ALLOWED_SCENES=scene.good_night

# Optional Life Dashboard internal API adapter. This is deliberately a future internal
# service-to-service API, not config.php browser/OIDC emulation.
LIFE_DASHBOARD_INTERNAL_URL=https://life.example.com/internal/mcp
LIFE_DASHBOARD_INTERNAL_TOKEN=replace-with-a-random-service-token

# Append-only JSON Lines audit log. Mount /app/data in Docker.
AUDIT_LOG_PATH=/app/data/audit.jsonl
